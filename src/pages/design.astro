---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ColorField from '../components/ColorField.astro';
import { icons, type IconName } from '../icons';
import { TOOLS } from '../data/tools';
import { DESIGN_SECTIONS } from '../data/nav';
import { SITE } from '../data/site';
import '../styles/tool.css';
import '../styles/tools/icon-maker.css';
import '../styles/design.css';

const title = 'Design System | s17 Labs';
const description =
  'The s17 Labs design system and brand kit — colors, typography, iconography, components, and usage docs for the homepage and tools.';

interface Swatch { name: string; value: string; use: string; swatch?: boolean; }

const coreColors: Swatch[] = [
  { name: '--primary', value: '#0e0e10', use: 'Page background (global.css)' },
  { name: '--accent', value: '#ff4136', use: 'Brand red — actions, active states, logo cube' },
  { name: '--accent-hover', value: '#e8382e', use: 'Accent hover (Download All, ready buttons)' },
  { name: '--primary-text', value: '#f1f1f1', use: 'Headings, body copy, values' },
  { name: '--secondary-text', value: '#909090', use: 'Labels, hints, placeholders, meta' },
  { name: '--btn-bg', value: '#1a1a1c', use: 'Default button fill' },
  { name: '--surface-1', value: '#161618', use: 'Wells nested inside a surface (search field)' },
  { name: '--surface-2', value: '#1a1a1c', use: 'Panels, inputs, menu' },
  { name: '--surface-3', value: '#222226', use: 'Slider tracks, thumbnails, bar specimens' },
  { name: '--border', value: 'rgba(255, 255, 255, 0.07)', use: 'Hairline borders everywhere' },
  { name: '--accent-dim', value: 'rgba(255, 65, 54, 0.12)', use: 'Active option tint, hover wash' },
  { name: '--overlay-dim', value: 'rgba(14, 14, 16, 0.72)', use: 'Image overflow dim, dialogs' },
  { name: '--radius', value: '4px', use: 'One radius, three functional exceptions', swatch: false },
  { name: '--t', value: '0.25s ease', use: 'The single easing', swatch: false },
];

const toolColors: Swatch[] = [
  { name: '--accent-soft', value: 'rgba(255, 65, 54, 0.4)', use: 'Hover borders, text selection' },
  { name: '--accent-focus', value: 'rgba(255, 65, 54, 0.5)', use: 'Focus borders' },
  { name: '--android', value: '#3ddc84', use: 'Android export accents, success' },
  { name: '--android-dim', value: 'rgba(61, 220, 132, 0.12)', use: 'Android button fill' },
  { name: '--tile-bg', value: 'rgba(255, 255, 255, 0.05)', use: 'Overflow tiles' },
];

const iconNames = Object.keys(icons) as IconName[];

const textFonts = [
  'System Sans',
  'System Serif',
  'System Mono',
  'Alien Block',
  'Anton',
  'Archivo Black',
  'Bebas Neue',
  'Lobster',
  'Montserrat',
  'Oswald',
  'Playfair Display',
  'Roboto',
  'JetBrains Mono',
];
---

<BaseLayout
  title={title}
  description={description}
  barTitle="Design System"
  backHref="/"
  backLabel="Home"
  barWidth={900}
>
  <div class="ds-page">
    <p class="ds-lead">
      The visual language behind s17 Labs — one dark-first system shared by the
      homepage, the footer, and every tool. Tokens live in
      <code>src/styles/global.css</code> (chrome) and
      <code>src/styles/tool.css</code> (tools); components below are live
      specimens using the real classes, so this page can never drift from
      production.
    </p>

    <nav class="ds-nav" aria-label="Design system sections">
      {DESIGN_SECTIONS.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
    </nav>

    <!-- Brand -->
    <section class="ds-section" id="brand">
      <p class="ds-kicker">Brand</p>
      <h2>Brand</h2>
      <p>
        The mark is a solid accent square — the <code>.cube</code> — set in
        Aldrich next to the <code>s17 Labs.</code> wordmark (period included).
        It appears in the homepage hero, every tool header, and the footer,
        always at <code>0.82em</code> of the surrounding type size.
      </p>
      <div class="ds-lockup"><span class="cube"></span> s17 Labs.</div>
      <div class="ds-demo">
        <small>brand assets — public/</small>
        <div class="ds-badges">
          <div class="preview-badge">favicon — <span>favicon.ico</span></div>
          <div class="preview-badge">social card — <span>link_preview.png · 1280×640</span></div>
          <div class="preview-badge">display font — <span>/fonts/aldrich-latin.woff2</span></div>
          <div class="preview-badge">icon — <span>s17labs-icon-large.png</span></div>
          <div class="preview-badge">icon — <span>s17labs-icon-large-transparent.png</span></div>
          <div class="preview-badge">lockup — <span>s17labs-logo-dark.png</span></div>
          <div class="preview-badge">lockup — <span>s17labs-logo-dark-transparent.png</span></div>
        </div>
      </div>
      <p>
        Voice: dark-first, minimal, no gradients on chrome. Everything ships
        self-hosted — fonts, icon data, styles — except Icon Maker emoji SVGs,
        which load from a CDN at runtime.
      </p>
    </section>

    <!-- Colors -->
    <section class="ds-section" id="colors">
      <p class="ds-kicker">Foundations</p>
      <h2>Colors</h2>
      <p>Core tokens from <code>global.css</code>, then the tool palette from <code>tool.css</code>.</p>
      <div class="ds-swatches">
        {coreColors.map((c) => (
          <div class="ds-swatch">
            <i style={c.swatch !== false && (c.value.startsWith('#') || c.value.startsWith('rgb')) ? `background:${c.value}` : undefined}></i>
            <div><b>{c.name}</b><span>{c.value}</span><em>{c.use}</em></div>
          </div>
        ))}
      </div>
      <div class="ds-swatches">
        {toolColors.map((c) => (
          <div class="ds-swatch">
            <i style={c.swatch !== false && (c.value.startsWith('#') || c.value.startsWith('rgb')) ? `background:${c.value}` : undefined}></i>
            <div><b>{c.name}</b><span>{c.value}</span><em>{c.use}</em></div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography -->
    <section class="ds-section" id="typography">
      <p class="ds-kicker">Foundations</p>
      <h2>Typography</h2>
      <p>
        Three families, each with one job. <code>Aldrich</code> is the brand
        voice (self-hosted woff2, latin subset, preloaded); body copy is
        <code>Verdana</code>; anything machine-read — inputs, hex codes,
        badges, labels-as-data — is <code>Courier New</code> monospace.
      </p>
      <div class="ds-type"><small>Aldrich — display · headings, panel titles, badges</small><p class="ds-display">Build lightly. Ship fast. Aa 0123456789</p></div>
      <div class="ds-type"><small>Verdana — text · body, buttons, descriptions</small><p class="ds-body-sample">Your data never leaves your browser. Tools run entirely on-device — fast, private, and free.</p></div>
      <div class="ds-type"><small>Courier New — data · inputs, hex, meta, code</small><p class="ds-mono-sample">#ff4136 → #ffffff @ 90° · 512×512 · ic_launcher.xml</p></div>
      <table class="ds-table">
        <thead><tr><th>Usage</th><th>Spec</th></tr></thead>
        <tbody>
          <tr><td>Page title</td><td>Aldrich, cube 0.82em + 0.25em gap — home hero 2em (1.8rem under 580px), top bar 1.5rem (1.35rem under 580px)</td></tr>
          <tr><td>Panel title</td><td>Aldrich 0.7rem, uppercase, 0.14em tracking, secondary text</td></tr>
          <tr><td>Form label</td><td>Verdana 0.74rem, uppercase, 0.09em tracking, secondary text</td></tr>
          <tr><td>Body / tagline</td><td>Verdana 0.95–1rem, 1.6 line-height, 520px measure</td></tr>
          <tr><td>Inputs / meta</td><td>Courier New 0.88rem values · 0.65–0.75rem badges and hints</td></tr>
          <tr><td>Search field</td><td>Verdana 0.95rem — the one input that takes body copy, so it speaks body copy, not Courier</td></tr>
        </tbody>
      </table>
      <p>
        Icon Maker ships 13 typefaces for icon text (first three are system
        stacks, the rest bundled woff2 under SIL OFL): {textFonts.join(' · ')}.
      </p>
    </section>

    <!-- Iconography -->
    <section class="ds-section" id="icons">
      <p class="ds-kicker">Foundations</p>
      <h2>Iconography</h2>
      <p>
        Product glyphs come from Font Awesome (-solid/regular/brands via npm)
        through a single registry — <code>src/icons.ts</code>. UI code renders
        them with the <code>&lt;Icon name&gt;</code> component (Astro) or
        <code>iconSvg(name)</code> (vanilla TS). Every bundled glyph:
      </p>
      <div class="ds-icons">
        {iconNames.map((n) => (
          <div class="ds-icon"><Icon name={n} /><span>{n}</span></div>
        ))}
      </div>
      <div class="ds-demo" style="margin-top:0.6rem;">
        <small>motion — .spin · s17-spin 2s linear infinite</small>
        <div><Icon name="circle-notch" class="spin" /></div>
      </div>
    </section>

    <!-- Spacing -->
    <section class="ds-section" id="spacing">
      <p class="ds-kicker">Foundations</p>
      <h2>Spacing · Radius · Borders</h2>
      <p>
        One radius token (<code>--radius: 4px</code>) with three functional
        exceptions. Borders are hairlines — <code>1px solid var(--border)</code> —
        or the 2px dashed drop-zone. Motion is a single easing
        (<code>--t: 0.25s ease</code>).
      </p>
      <div class="ds-radii">
        <div class="ds-radius"><i style="border-radius:4px;"></i><span>--radius · 4px</span></div>
        <div class="ds-radius"><i style="border-radius:3px;"></i><span>thumbs · 3px</span></div>
        <div class="ds-radius"><i style="border-radius:99px;"></i><span>pills/tracks · 99px</span></div>
        <div class="ds-radius"><i style="border-radius:50%;width:44px;height:44px;"></i><span>dots · 50%</span></div>
      </div>
      <table class="ds-table">
        <thead><tr><th>Token</th><th>Spec</th></tr></thead>
        <tbody>
          <tr><td>.page / .tool-top</td><td>680px default (ToolLayout); most tools override 640px, Icon Maker 900px · 20px side padding</td></tr>
          <tr><td>Icon Maker page</td><td>900px max (ToolLayout maxWidth)</td></tr>
          <tr><td>.tool-desc</td><td>520px centered measure</td></tr>
          <tr><td>.panel</td><td>1.4rem padding, 1rem bottom margin</td></tr>
          <tr><td>breakpoints</td><td>580px (tools, footer) · 680px (icon-maker only)</td></tr>
        </tbody>
      </table>
    </section>

    <!-- Navigation -->
    <section class="ds-section" id="navigation">
      <p class="ds-kicker">Components</p>
      <h2>Navigation</h2>
      <p>
        The <code>.topbar</code> is the site's spine — it carries the page
        header, the back link, search, and the menu on every page but home,
        rendered by <code>BaseLayout</code> so a page never hand-rolls its own
        header. Home gets a lone <code>.search-fab</code> instead — no fill,
        no outline, just a backdrop blur so it floats over whatever scrolls
        under it. The bar sticks and
        <code>--topbar-w</code> matches that page's content measure (680
        tools, 900 design) so the bar and the column share an edge. Back link,
        header, search, and menu are a three-slot <code>1fr auto 1fr</code>
        grid, which keeps the header optically centered at any width and gives
        the back label room to breathe — no measurement script. At the top of
        the page the bar is invisible (page-colored, no rule);
        <code>.is-scrolled</code> fades in the blur and hairline. Design
        sections are reachable by search rather than a menu — the menu stays
        short enough to scan in one glance. Below it, tool cards and lowercase
        Courier tags carry browsing; cards lift with an accent wash on hover,
        so position never shifts.
      </p>
      <div class="ds-demo">
        <small>.topbar-back · .topbar-heading · .topbar-btn ×2</small>
        <div class="ds-topbar-sample">
          <a href="/" class="topbar-back" aria-label="Back to Home">
            <span class="topbar-btn topbar-back-btn"><Icon name="arrow-left" /></span>
            <span class="topbar-back-label">Home</span>
          </a>
          <div class="topbar-heading">
            <span class="cube"></span>
            <span class="topbar-title">Design System</span>
          </div>
          <div class="topbar-actions">
            <button type="button" class="topbar-btn" data-search-open aria-label="Search"><Icon name="search" /></button>
            <button type="button" class="topbar-btn" aria-expanded="false" aria-label="Menu specimen" data-specimen="Menu is a visual specimen on this page.">
              <span class="topbar-glyph" data-glyph="open"><Icon name="bars" /></span>
              <span class="topbar-glyph" data-glyph="close"><Icon name="xmark" /></span>
            </button>
          </div>
        </div>
      </div>
      <div class="ds-demo">
        <small>.search-fab — home page, no toolbar</small>
        <div class="ds-topbar-sample" style="position:relative;min-height:4rem;">
          <button type="button" class="search-fab" data-search-open aria-label="Search" style="position:static;">
            <Icon name="search" />
          </button>
        </div>
      </div>
      <div class="ds-demo">
        <small>.topbar-link · .topbar-social — menu contents</small>
        <div class="ds-menu-sample">
          <a href={SITE.toolsUrl} class="topbar-link">
            <span class="topbar-link-label">Tools</span>
            <span class="topbar-link-desc">Browser utilities that run entirely on your device.</span>
          </a>
          <div class="topbar-socials">
            <a href={SITE.orgUrl} class="topbar-social" aria-label="GitHub"><Icon name="github" /></a>
            <a href={SITE.socials.x.url} class="topbar-social" aria-label={SITE.socials.x.name}><Icon name="x" /></a>
            <a href={SITE.socials.discord.url} class="topbar-social" aria-label={SITE.socials.discord.name}><Icon name="discord" /></a>
          </div>
        </div>
      </div>
      <div class="ds-demo">
        <small>.topbar-search-field · .topbar-search-clear — Verdana, one line box; the ✕ is hidden with no query (press <kbd>/</kbd> or <kbd>⌘K</kbd> for the live one)</small>
        <div class="topbar-search-field" style="margin:0 0 0.6rem;">
          <Icon name="search" class="topbar-search-icon" />
          <input type="text" class="topbar-search-input" value="icon" readonly aria-label="Search field specimen with text" />
          <button type="button" class="topbar-search-clear" aria-label="Clear search specimen"><Icon name="xmark" /></button>
        </div>
        <div class="topbar-search-field" style="margin:0;">
          <Icon name="search" class="topbar-search-icon" />
          <input type="text" class="topbar-search-input" placeholder="empty — no clear button" readonly aria-label="Empty search field specimen" />
          <button type="button" class="topbar-search-clear" aria-label="Clear search specimen" hidden><Icon name="xmark" /></button>
        </div>
        <div class="topbar-results" style="border:1px solid var(--border);border-radius:var(--radius);">
          {TOOLS.slice(0, 2).map((tool) => (
            <a href={`${SITE.toolsUrl}${tool.slug}/`} class="topbar-result">
              <span class="topbar-result-icon"><Icon name={tool.icon} /></span>
              <span class="topbar-result-text">
                <span class="topbar-result-label">{tool.name}</span>
                <span class="topbar-result-hint">{tool.description}</span>
              </span>
              <span class="topbar-result-kind">Tool</span>
            </a>
          ))}
        </div>
      </div>
      <div class="ds-demo">
        <small>.tool-tag ×{TOOLS[0].tags.length}</small>
        <div>
          {TOOLS[0].tags.map((tag) => (
            <span class="tool-tag">{tag}</span>
          ))}
        </div>
      </div>
      <div class="ds-demo">
        <small>.link · .link-primary · .link-secondary · .link-ghost</small>
        <p class="ds-body-sample">
          <a href="/tools/" class="link">Normal link</a>
          ·
          <a href="/tools/" class="link-primary">Primary link</a>
          ·
          <a href="/tools/" class="link-secondary">Secondary link</a>
          ·
          <a href="/tools/" class="link-ghost">Ghost link</a>
        </p>
      </div>
      <div class="ds-demo">
        <small>.link-icon — composes with any flavor</small>
        <p class="ds-body-sample" style="display:flex;gap:1.1rem;flex-wrap:wrap;">
          <a href="/tools/" class="link link-icon"><Icon name="github" /> Normal + icon</a>
          <a href="/tools/" class="link-primary link-icon">Primary + arrow <Icon name="arrow-right" /></a>
          <a href="/tools/" class="link-secondary link-icon"><Icon name="globe" /> Secondary + icon</a>
          <a href="/tools/" class="link-ghost link-icon"><Icon name="toolbox" /> Ghost + icon</a>
        </p>
      </div>
      <div class="ds-demo">
        <small>.link-secondary-permanent — privacy/terms links</small>
        <p class="ds-body-sample">
          <a href="/tools/" class="link-secondary-permanent">Permanent underline</a>
        </p>
      </div>
      <div class="ds-demo">
        <small>.tool-item icon variants — glyph · artwork · emoji</small>
        <div style="display:flex;gap:0.6rem;align-items:center;">
          <div class="tool-item-icon"><Icon name="icons" /></div>
          <div class="tool-item-icon has-img"><img src="/projects/koda-app-icon.png" alt="Koda icon" width="256" height="256" loading="lazy" /></div>
          <div class="tool-item-icon has-emoji"><span class="tool-item-emoji" aria-hidden="true">🐚</span></div>
        </div>
      </div>
      <div class="ds-demo">
        <small>.tool-item — links /tools/&lt;slug&gt;/</small>
        <a href={`${SITE.toolsUrl}${TOOLS[0].slug}/`} class="tool-item">
          <div class="tool-item-left">
            <div class="tool-item-icon">
              <Icon name={TOOLS[0].icon} />
            </div>
            <div class="tool-item-info">
              <h3>{TOOLS[0].name}</h3>
              <p>{TOOLS[0].description}</p>
              {TOOLS[0].tags.map((tag) => (
                <span class="tool-tag">{tag}</span>
              ))}
            </div>
          </div>
          <span class="tool-item-arrow">
            <Icon name="arrow-right" />
          </span>
        </a>
      </div>
      <div class="ds-center">
        <a class="ds-more" href={SITE.orgUrl} target="_blank" rel="noopener noreferrer">
          View all repositories <Icon name="arrow-right" />
        </a>
      </div>
    </section>

    <!-- Buttons -->
    <section class="ds-section" id="buttons">
      <p class="ds-kicker">Components</p>
      <h2>Buttons</h2>
      <p>
        One primary button that fills its container and turns accent when it
        has something to do (<code>.ready</code>), plus a family of small
        controls. All transitions run on <code>var(--t)</code>.
      </p>
      <div class="ds-demo">
        <small>.btn · .btn.ready · .btn:disabled · .btn-fmt</small>
        <button type="button" class="btn">Export</button>
        <button type="button" class="btn ready">Export Ready</button>
        <button type="button" class="btn"><span class="btn-fmt">SVG</span> Export</button>
        <button type="button" class="btn" disabled>Disabled</button>
      </div>
      <div class="ds-demo">
        <small>.btn-sm · .choice-btn ×3 · .btn-row · .dz-change · .result-dl</small>
        <div class="btn-row">
          <button type="button" class="btn-sm">Small</button>
          <button type="button" class="btn-sm">Action</button>
        </div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button type="button" class="choice-btn">Choice</button>
          <button type="button" class="choice-btn active">Active</button>
          <button type="button" class="choice-btn">Choice</button>
        </div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
          <button type="button" class="dz-change">Change</button>
          <button type="button" class="result-dl">Download</button>
        </div>
      </div>
      <div class="ds-demo">
        <small>.dl-all-btn · .more-tools-btn · .android-btn (icon-maker)</small>
        <button type="button" class="dl-all-btn"><Icon name="download" />Download All</button>
        <div><a href="/tools/" class="more-tools-btn"><Icon name="arrow-left" />View More Tools</a></div>
        <button type="button" class="android-btn">
          <span style="font-size:1.05rem;display:inline-flex;"><Icon name="android" /></span>
          <span><span class="android-label">Export Android Package</span><span class="android-sub"> · .zip</span></span>
        </button>
      </div>
    </section>

    <!-- Forms -->
    <section class="ds-section" id="forms">
      <p class="ds-kicker">Components</p>
      <h2>Forms</h2>
      <p>
        Fields stack label → control → hint with a 0.45rem rhythm. Text inputs
        speak Courier; selects speak Verdana with a CSS chevron. Color fields
        use <code>ColorField.astro</code> — a swatch that opens the shared
        canvas picker next to its hex input. Focus is never color-shift alone
        — every control also draws the accent <code>:focus-visible</code> ring.
      </p>
      <div class="ds-demo">
        <small>input · number · textarea · select · range</small>
        <div class="field">
          <span class="group-label">Text input</span>
          <input type="text" value="star" readonly aria-label="Text input specimen" />
        </div>
        <div class="field">
          <span class="group-label">Number</span>
          <input type="number" value="128" readonly aria-label="Number input specimen" />
        </div>
        <div class="field">
          <span class="group-label">Textarea</span>
          <textarea readonly aria-label="Textarea specimen">Your data never leaves your browser.</textarea>
        </div>
        <div class="field">
          <span class="group-label">Select</span>
          <select aria-label="Select specimen"><option>System Sans</option><option>Montserrat</option></select>
        </div>
        <div class="field">
          <span class="group-label">Range — filled trail (70%)</span>
          <input type="range" min="0" max="100" value="70" aria-label="Range specimen" />
        </div>
        <div class="field">
          <span class="group-label">Hint</span>
          <input type="text" value="128" readonly aria-label="Hint example input" />
          <div class="field-note">Small hint under a field.</div>
        </div>
      </div>
      <div class="ds-demo">
        <small>ColorField.astro · .color-row · .divider</small>
        <div class="color-row">
          <ColorField id="ds-fg" label="Foreground" value="#f1f1f1" />
          <ColorField id="ds-bg" label="Background" value="#0e0e10" />
        </div>
        <hr class="divider" />
        <div class="panel-header-row">
          <div class="panel-title">Output</div>
          <button type="button" class="choice-btn" data-specimen="Clear is a visual specimen on this page.">Clear</button>
        </div>
      </div>
      <div class="ds-demo">
        <small>.checkbox-row · .drop-zone (icon-maker patterns)</small>
        <label class="checkbox-row">
          <span class="custom-checkbox">
            <input type="checkbox" checked />
            <span class="checkbox-box"><Icon name="check" /></span>
          </span>
          <span class="checkbox-text">
            <span class="checkbox-label">Include Material You / Themed Icons</span>
            <span class="checkbox-sub">Adds &lt;monochrome&gt; layer for Android 13+</span>
          </span>
        </label>
        <div class="drop-zone">
          <div class="dz-empty">
            <Icon name="image" size={28} />
            <p>Drop images here or click to browse</p>
            <span>PNG, JPG, SVG, WebP — processed on-device</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Feedback -->
    <section class="ds-section" id="feedback">
      <p class="ds-kicker">Components</p>
      <h2>Feedback</h2>
      <p>
        Messages reserve their line (<code>min-height: 1.1em</code>) so showing
        one never shifts layout. Errors speak accent red, success speaks
        Android green. Long operations use the 3px progress track; blocking
        choices use the modal.
      </p>
      <div class="ds-demo">
        <small>.status-msg.error / .success · .zip-progress-* · .spin</small>
        <div class="status-msg error visible">Icon not found — check the spelling.</div>
        <div class="status-msg success visible">Done — 11 images + XMLs.</div>
        <div class="zip-progress-wrap visible">
          <div
            class="zip-progress-track"
            role="progressbar"
            aria-label="Example ZIP progress"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="64"
          >
            <div class="zip-progress-fill" style="width:64%;"></div>
          </div>
          <div class="zip-progress-label">mipmap-xxhdpi/ic_launcher.png 144px…</div>
        </div>
      </div>
      <div class="ds-demo">
        <small>selection — drag across this sentence</small>
        <p class="ds-body-sample">
          Selected text wears <code>--accent-soft</code> with primary text on
          top, set once in <code>global.css</code> so it holds on every page
          instead of being re-declared per stylesheet.
        </p>
      </div>
      <div class="ds-demo">
        <small>.results-list · .result-item</small>
        <div class="results-list">
          <div class="result-item">
            <div class="result-thumb"></div>
            <div class="result-info">
              <div class="result-name">icon-512x512.png</div>
              <div class="result-meta"><span>512 × 512</span><span>84 KB</span></div>
            </div>
            <button type="button" class="result-dl">Save</button>
          </div>
        </div>
      </div>
      <div class="ds-demo">
        <small>.modal-* — blocking choices (live demo)</small>
        <div><button type="button" class="choice-btn" id="ds-modal-open" aria-haspopup="dialog" aria-controls="ds-modal-demo">Open dialog demo</button></div>
      </div>
    </section>

    <!-- Contributing -->
    <section class="ds-section" id="contributing">
      <p class="ds-kicker">Guidelines</p>
      <h2>Contributing</h2>
      <p>
        New tool pages must use <code>ToolLayout</code> plus the
        <code>tool.css</code> tokens above — no bespoke styling. Anything used
        twice gets promoted from the tool stylesheet into
        <code>tool.css</code>. A new tool touches exactly three places:
        <code>src/pages/tools/&lt;slug&gt;.astro</code>,
        <code>src/scripts/tools/&lt;slug&gt;.ts</code>, and the registry in
        <code>src/data/tools.ts</code>. Conventions, commits, and PR rules live
        in <code>AGENTS.md</code>.
      </p>
      <table class="ds-table">
        <thead><tr><th>Rule</th><th>Spec</th></tr></thead>
        <tbody>
          <tr><td>Client-side only</td><td>No server endpoints, no analytics — data never leaves the browser</td></tr>
          <tr><td>Typecheck</td><td>Client TS is checked by astro check — no Node-only APIs in tools</td></tr>
          <tr><td>Commit</td><td>type(scope): short imperative summary, atomic, no AI trailers</td></tr>
          <tr><td>CSS order</td><td>Page stylesheets load before tool.css in prod — beat shared rules with specificity, never order</td></tr>
          <tr><td>Selection</td><td><code>::selection</code> is the accent tint site-wide (global.css) — the default blue is the one color that isn't ours</td></tr>
          <tr><td>Headers</td><td>Every page's header and back link come from the top bar (<code>BaseLayout</code> + <code>TopBar.astro</code>) — never hand-rolled per page</td></tr>
        </tbody>
      </table>
    </section>
  </div>

  <!-- Modal demo (real .modal-* classes) -->
  <div class="modal-overlay" id="ds-modal-demo">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="ds-modal-title" aria-describedby="ds-modal-text">
      <div class="modal-title" id="ds-modal-title">Square background recommended</div>
      <p class="modal-text" id="ds-modal-text">Android applies its own mask (circle, squircle, …) to adaptive icons. A baked-in circle or rounded background will clash with it.</p>
      <div class="modal-actions">
        <button type="button" class="modal-btn primary" id="ds-modal-ok">Got it</button>
      </div>
    </div>
  </div>
