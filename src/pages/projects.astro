---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { PROJECTS, PROJECTS_SECTION } from '../data/projects';
import '../styles/tool.css';
import '../styles/design.css';

const title = `${PROJECTS_SECTION.title} | s17 Labs`;
---

<BaseLayout
  title={title}
  description={PROJECTS_SECTION.description}
  barTitle={PROJECTS_SECTION.title}
  backHref="/"
  backLabel="Home"
  barWidth={900}
>
  <div class="ds-page">
    <p class="ds-lead">{PROJECTS_SECTION.description}</p>

    <div class="tool-list">
      {
        PROJECTS.map((project) => (
          <a
            href={project.url}
            class="tool-item"
            target={project.external ? '_blank' : undefined}
            rel={project.external ? 'noopener noreferrer' : undefined}
          >
            <div class="tool-item-left">
              <div class:list={['tool-item-icon', { 'has-img': project.iconImg, 'has-emoji': project.emoji }]}>
                {project.iconImg ? (
                  <img src={project.iconImg} alt={`${project.name} icon`} />
                ) : project.emoji ? (
                  <span class="tool-item-emoji" aria-hidden="true">{project.emoji}</span>
                ) : (
                  <Icon name={project.icon} />
                )}
              </div>
              <div class="tool-item-info">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                {project.tags.map((tag) => (
                  <span class="tool-tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="tool-item-arrow">
              <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>

    <div class="ds-center">
      <a class="ds-more" href="https://github.com/orgs/s17labs/repositories" target="_blank" rel="noopener noreferrer">
        View all repositories <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</BaseLayout>

