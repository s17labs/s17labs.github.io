---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { PROJECTS, PROJECTS_SECTION } from '../data/projects';
import '../styles/tool.css';
import '../styles/design.css';

const title = `${PROJECTS_SECTION.title} | s17 Labs`;
---

<BaseLayout title={title} description={PROJECTS_SECTION.description}>
  <div class="ds-page">
    <header class="ds-hero">
      <a href="/" class="back-link" aria-label="Back to Home">
        <Icon name="arrow-left" /><span class="back-label">Home</span>
      </a>
      <h1><span class="cube"></span> {PROJECTS_SECTION.title}</h1>
    </header>
    <p class="ds-lead">{PROJECTS_SECTION.description}</p>

    <div class="tool-list">
      {
        PROJECTS.map((project) => (
          <a
            href={project.url}
            class="tool-item"
            target={project.external ? '_blank' : undefined}
            rel={project.external ? 'noopener noreferrer' : undefined}
          >
            <div class="tool-item-left">
              <div class:list={['tool-item-icon', { 'has-img': project.iconImg }]}>
                {project.iconImg ? (
                  <img src={project.iconImg} alt={`${project.name} icon`} loading="lazy" />
                ) : (
                  <Icon name={project.icon} />
                )}
              </div>
              <div class="tool-item-info">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                {project.tags.map((tag) => (
                  <span class="tool-tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="tool-item-arrow">
              <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/back-link';
</script>
