---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { TOOLS, TOOLS_SECTION } from '../../data/tools';
import { SITE } from '../../data/site';
import '../../styles/tool.css';
---

<BaseLayout
  title={TOOLS_SECTION.title}
  description={TOOLS_SECTION.description}
  barTitle="Tools"
  backHref="/"
  backLabel="Home"
  barWidth={900}
>
  <div class="tool-top">
    <p class="tool-desc">{TOOLS_SECTION.description}</p>
  </div>

  <div class="page">
    <div class="tool-list">
      {
        TOOLS.map((tool) => (
          <a href={`${SITE.toolsUrl}${tool.slug}/`} class="tool-item">
            <div class="tool-item-left">
              <div class="tool-item-icon">
                <Icon name={tool.icon} />
              </div>
              <div class="tool-item-info">
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
                {tool.tags.map((tag) => (
                  <span class="tool-tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="tool-item-arrow">
              <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>

  </div>
</BaseLayout>

<style>
  /* This listing runs the wide 900px measure, like /projects/ and /design/,
     so the bar and the cards share both edges. Astro scopes these to
     .tool-top[data-astro-cid-*] (0,2,0), which out-specifies the shared
     680px rules in tool.css without relying on load order. */
  .tool-top,
  .page {
    max-width: 900px;
  }

  .page {
    width: 100%;
    padding: 0 20px 7rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
</style>
