---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BackLinkFit from '../../components/BackLinkFit.astro';
import { TOOLS, TOOLS_SECTION } from '../../data/tools';
import { SITE } from '../../data/site';
import '../../styles/tool.css';
---

<BaseLayout title={TOOLS_SECTION.title} description={TOOLS_SECTION.description}>
  <div class="tool-top">
    <div class="tool-header">
      <a href="/" class="back-link" aria-label="Back to Home">
        <Icon name="arrow-left" /><span class="back-label">Home</span>
      </a>
      <h1><span class="cube"></span> Tools</h1>
    </div>
    <BackLinkFit />

    <p class="tool-desc">{TOOLS_SECTION.description}</p>
  </div>

  <div class="page">
    <div class="tool-list">
      {
        TOOLS.map((tool) => (
          <a href={`${SITE.toolsUrl}${tool.slug}/`} class="tool-item">
            <div class="tool-item-left">
              <div class="tool-item-icon">
                <Icon name={tool.icon} />
              </div>
              <div class="tool-item-info">
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
                {tool.tags.map((tag) => (
                  <span class="tool-tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="tool-item-arrow">
              <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>

  </div>
</BaseLayout>

<style>
  :root {
    --surface-2: #1a1a1c;
    --border: rgba(255, 255, 255, 0.07);
    --accent-dim: rgba(255, 65, 54, 0.12);
    --radius: 4px;
    --t: 0.25s ease;
  }

  ::selection {
    background: rgba(255, 65, 54, 0.4);
  }

  .page {
    width: 100%;
    max-width: 680px;
    padding: 0 20px 7rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

</style>

<script>
  import '../../scripts/back-link';
</script>
