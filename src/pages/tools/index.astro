---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { TOOLS, TOOLS_SECTION } from '../../data/tools';
import { CHANGELOG } from '../../data/changelog';
import { SITE } from '../../data/site';
import '../../styles/tool.css';
---

<BaseLayout
  title={TOOLS_SECTION.title}
  description={TOOLS_SECTION.description}
  barTitle="Tools"
  backHref="/"
  backLabel="Home"
  barWidth={900}
>
  <div class="tool-top">
    <p class="tool-desc">{TOOLS_SECTION.description}</p>
  </div>

  <div class="page">
    <div class="tool-list">
      {
        TOOLS.map((tool) => (
          <a href={`${SITE.toolsUrl}${tool.slug}/`} class="tool-item">
            <div class="tool-item-left">
              <div class="tool-item-icon">
                <Icon name={tool.icon} />
              </div>
              <div class="tool-item-info">
                <h2>{tool.name}</h2>
                <p>{tool.description}</p>
                {tool.tags.map((tag) => (
                  <span class="tool-tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="tool-item-arrow">
              <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>

    <section class="whats-new" aria-labelledby="whats-new-heading">
      <div class="whats-new-head">
        <h2 class="panel-title" id="whats-new-heading">What's new</h2>
        <a class="suggest-link" href="/changelog/">
          See all changes <Icon name="arrow-right" />
        </a>
      </div>
      <ul class="whats-new-list">
        {
          CHANGELOG.slice(0, 3).map((entry) => (
            <li class="whats-new-item">
              <time datetime={entry.date}>{entry.date}</time>
              <span>{entry.title}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="panel suggest-panel">
      <div class="suggest-copy">
        <h2>Suggest a tool</h2>
        <p>Have an idea for a lightweight, browser-based utility? Tell us what you need and we'll take a look.</p>
      </div>
      <a
        href="https://github.com/s17labs/s17labs.github.io/issues/new?template=tool-request.yml"
        class="suggest-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        Request a tool <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* The bar runs the wide 900px measure while the listing stays on the
     standard 680px column, so the two are deliberately different widths.
     Astro scopes these to .tool-top[data-astro-cid-*] / .page[data-astro-cid-*]
     (0,2,0), which out-specifies the shared 680px rules in tool.css without
     relying on load order. */
  .tool-top,
  .page {
    max-width: 680px;
  }

  .page {
    width: 100%;
    padding: 0 20px 7rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Compact changelog callout — same surface, hairline, and rhythm as the
     tool cards above it. Scoped selectors out-specify shared tool.css rules. */
  .whats-new {
    margin-top: 1.5rem;
    padding: 1.2rem 1.4rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .whats-new-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .whats-new-head .panel-title {
    margin-bottom: 0;
  }

  .whats-new-head a {
    font-size: 0.78rem;
    white-space: nowrap;
  }

  /* Shared accent link style (also used by the "Suggest a tool" panel). */

  /* Subtle suggestion panel — uses the shared .panel surface + tokens. */
  .suggest-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 1.75rem;
    margin-bottom: 0;
  }

  .suggest-copy h2 {
    font-family: Aldrich, sans-serif;
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .suggest-copy p {
    color: var(--secondary-text);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
  }

  .suggest-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    font-family: Verdana, sans-serif;
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    transition: var(--t);
  }

  .suggest-link:hover {
    color: var(--primary-text);
  }

  .suggest-link svg {
    transition: transform var(--t);
  }

  .suggest-link:hover svg {
    transform: translateX(3px);
  }

  .whats-new-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .whats-new-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .whats-new-item time {
    font-family: 'Courier New', monospace;
    font-size: 0.68rem;
    color: var(--secondary-text);
    flex-shrink: 0;
  }

  @media (max-width: 580px) {
    .suggest-panel {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
