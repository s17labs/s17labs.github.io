---
import ToolLayout from '../../components/ToolLayout.astro';
import Icon from '../../components/Icon.astro';

const title = 'Image Resizer | s17 Labs Tools';
const description =
  'Batch resize images with aspect ratio locking and high-quality output.';
const tagline = 'Batch resize images directly in your browser — your data never leaves your browser.';
---

<ToolLayout title={title} description={description} heading="Image Resizer" tagline={tagline} maxWidth={640}>
  <!-- Upload -->
  <div class="panel">
    <h2 class="panel-title">Upload</h2>
    <div class="drop-zone" id="drop-zone" tabindex="0" role="button" aria-label="Upload images — activate to open the file picker">
      <div class="dz-empty" id="dz-empty">
        <Icon name="cloud-arrow-up" size={29} />
        <p>Drag &amp; drop images here, or click to select</p>
        <span>PNG, JPG, GIF, WEBP &mdash; batch supported</span>
      </div>
      <div class="dz-filled" id="dz-filled">
        <div class="dz-preview-grid" id="dz-preview-grid"></div>
        <div class="dz-filled-meta">
          <span id="dz-count-label"></span>
          <button type="button" class="dz-change" id="dz-change-btn">
            <Icon name="plus" /> Add / Change
          </button>
        </div>
      </div>
    </div>
    <input type="file" id="file-input" accept="image/*" multiple />
  </div>

  <!-- Settings -->
  <div class="panel">
    <h2 class="panel-title">Resize Settings</h2>
    <div class="field">
      <label for="input-w">Dimensions (px)</label>
      <div class="input-row">
        <input type="number" id="input-w" placeholder="Width" min="1" max="8000" value="800" />
        <span class="input-sep">×</span>
        <input type="number" id="input-h" placeholder="Height" min="1" max="8000" value="600" />
      </div>
    </div>
    <div class="field">
      <div class="toggle-row" id="aspect-toggle-row" tabindex="0" role="switch" aria-checked="true" aria-label="Lock aspect ratio">
        <div class="toggle-track on" id="aspect-track">
          <div class="toggle-thumb"></div>
        </div>
        <span class="toggle-label" id="aspect-label">Lock Aspect Ratio</span>
      </div>
    </div>
    <button type="button" class="btn" id="resize-btn" disabled>
      <Icon name="scissors" /> Resize Images
    </button>
  </div>

  <!-- Results -->
  <div class="panel" id="results-panel" style="display:none;">
    <div class="panel-header-row">
      <h2 class="panel-title">Output</h2>
    </div>
    <!-- ZIP progress -->
    <div class="zip-progress-wrap" id="zip-progress-wrap">
      <div class="zip-progress-track"><div class="zip-progress-fill" id="zip-progress-fill"></div></div>
      <div class="zip-progress-label" id="zip-progress-label">Packing…</div>
    </div>
    <!-- Download button — label/icon adapt to single vs batch -->
    <button type="button" class="dl-all-btn" id="dl-all-btn" disabled>
      <span id="dl-icon"><Icon name="download" /></span>
      <span id="dl-label">Download Image</span>
    </button>
    <div class="results-list" id="results-list"></div>
  </div>
</ToolLayout>

<script>
  import '../../scripts/tools/image-resizer';
</script>

<style>
  /* Uploaded image thumbnails fill their tile */
  .dz-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Form fields */
  .input-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.6rem;
    align-items: center;
  }

  .input-sep {
    color: var(--secondary-text);
    text-align: center;
    font-size: 0.9rem;
  }

  input[type='number'] {
    text-align: center;
    font-size: 0.95rem;
  }

  /* Toggle */
  .toggle-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    user-select: none;
  }

  .toggle-track {
    width: 34px;
    height: 18px;
    background: var(--surface-3);
    border-radius: 99px;
    position: relative;
    transition: background var(--t);
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  .toggle-track.on {
    background: var(--accent);
    border-color: var(--accent);
  }

  .toggle-thumb {
    width: 12px;
    height: 12px;
    background: var(--secondary-text);
    border-radius: 50%;
    position: absolute;
    top: 2px;
    left: 2px;
    transition: all var(--t);
  }

  .toggle-track.on :global(.toggle-thumb) {
    left: 18px;
    background: #fff;
  }

  .toggle-label {
    font-size: 0.85rem;
    color: var(--secondary-text);
    transition: var(--t);
  }

  .toggle-row:has(.toggle-track.on) .toggle-label {
    color: var(--primary-text);
  }

  /* Resize button idle state */
  .btn:not(.ready):not(:disabled) {
    color: var(--accent);
  }

  .btn:not(.ready):not(:disabled):hover {
    background: var(--accent);
    color: #fff;
  }
</style>
