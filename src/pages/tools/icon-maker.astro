---
import ToolLayout from '../../components/ToolLayout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/tools/icon-maker.css';
import '../../styles/tools/icon-maker-fonts.css';

const title = 'Icon Maker | s17 Labs Tools';
const description =
  'Generate and export custom icons from Font Awesome, Bootstrap Icons, custom text, Noto Emoji, or Twemoji. Includes full Android launcher package export.';
const tagline =
  'Generate custom icons from Font Awesome, Bootstrap Icons, custom text, Noto Emoji, or Twemoji. Control colors, gradients, shape, and scale — export as SVG, PNG, or a full Android launcher package.';
---

<ToolLayout title={title} description={description} heading="Icon Maker" tagline={tagline} maxWidth={900}>
  <div class="workspace">
    <!-- Preview -->
    <div class="panel preview-panel">
      <div class="panel-title">Preview</div>
      <div class="canvas-wrapper">
        <div id="preview-container">
          <div class="icon-placeholder" id="placeholder">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"></path></svg>
            <p>Enter an icon name, text, or emoji to begin</p>
          </div>
          <div class="preview-loading" id="preview-loading">
            <span style="display:inline-flex;"><Icon name="circle-notch" class="spin" /></span>
            <span>Fetching emoji…</span>
          </div>
        </div>
      </div>
      <div class="preview-meta" id="preview-meta" style="display:none;">
        <div class="preview-badge">source: <span id="meta-source">—</span></div>
        <div class="preview-badge">icon: <span id="meta-icon">—</span></div>
        <div class="preview-badge">bg: <span id="meta-bg">—</span></div>
      </div>
      <div class="android-preview" id="android-preview">
        <div class="android-preview-title">Android Adaptive Preview</div>
        <div class="android-sizes-row" id="android-sizes-row"></div>
      </div>
    </div>

    <!-- Controls -->
    <div class="controls-col">
      <!-- Icon panel -->
      <div class="panel">
        <div class="panel-title">Icon</div>

        <!-- Source selector -->
        <div class="source-row">
          <button type="button" class="source-btn active" data-source="fa" aria-pressed="true">
            <span class="src-ico"><Icon name="icons" /></span>
            <span class="src-lbl">Font Awesome</span>
          </button>
          <button type="button" class="source-btn" data-source="bi" aria-pressed="false">
            <span class="src-ico"><Icon name="bootstrap" /></span>
            <span class="src-lbl">Bootstrap</span>
          </button>
          <button type="button" class="source-btn" data-source="text" aria-pressed="false">
            <span class="src-ico"><Icon name="font" /></span>
            <span class="src-lbl">Text</span>
          </button>
          <button type="button" class="source-btn" data-source="noto" aria-pressed="false">
            <span class="src-ico">🌈</span>
            <span class="src-lbl">Noto Emoji</span>
          </button>
          <button type="button" class="source-btn" data-source="twemoji" aria-pressed="false">
            <span class="src-ico">🐦</span>
            <span class="src-lbl">Twemoji</span>
          </button>
        </div>

        <div class="field">
          <label for="icon-input" id="input-label">Font Awesome Icon Name</label>
          <input type="text" id="icon-input" placeholder="e.g. star, circle-check, bolt" spellcheck="false" autocomplete="off" />
          <div class="status-msg error" id="error-msg">Icon not found — check spelling at <a href="https://fontawesome.com/search?ic=free-collection" target="_blank" rel="noopener">fontawesome.com</a></div>
        </div>
      </div>

      <!-- Text style panel (text source only) -->
      <div class="panel" id="text-style-panel">
        <div class="panel-title">Text Style</div>
        <div class="field">
          <label for="font-select">Font</label>
          <select id="font-select" class="font-select">
            <option value="System Sans" selected>System Sans</option>
            <option value="System Serif">System Serif</option>
            <option value="System Mono">System Mono</option>
            <option value="Alien Block">Alien Block</option>
            <option value="Anton">Anton</option>
            <option value="Archivo Black">Archivo Black</option>
            <option value="Bebas Neue">Bebas Neue</option>
            <option value="Lobster">Lobster</option>
            <option value="Montserrat">Montserrat</option>
            <option value="Oswald">Oswald</option>
            <option value="Playfair Display">Playfair Display</option>
            <option value="Roboto">Roboto</option>
            <option value="JetBrains Mono">JetBrains Mono</option>
          </select>
          <div class="font-note">Bundled with the tool — works offline.</div>
        </div>
        <div class="field">
          <label>Style</label>
          <div class="style-row">
            <button type="button" class="style-btn active" id="style-bold" title="Bold" aria-pressed="true"><b>B</b></button>
            <button type="button" class="style-btn" id="style-italic" title="Italic" aria-pressed="false"><i>I</i></button>
            <button type="button" class="style-btn" id="style-underline" title="Underline" aria-pressed="false"><u>U</u></button>
            <select id="font-weight" class="weight-select" aria-label="Font weight">
              <option value="100">Thin 100</option>
              <option value="200">Extra Light 200</option>
              <option value="300">Light 300</option>
              <option value="400">Regular 400</option>
              <option value="500">Medium 500</option>
              <option value="600">Semi Bold 600</option>
              <option value="700" selected>Bold 700</option>
              <option value="800">Extra Bold 800</option>
              <option value="900">Black 900</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="text-spacing">Character Spacing — <span id="spacing-label">0</span></label>
          <input type="range" id="text-spacing" min="-10" max="30" step="0.5" value="0" />
        </div>
      </div>

      <!-- Colors panel -->
      <div class="panel">
        <div class="panel-title">Colors</div>
        <div class="color-row">
          <div class="color-field" id="icon-color-field">
            <label>Icon Color</label>
            <div class="cp-row" id="cp-row-icon">
              <button type="button" class="cp-swatch" id="cp-swatch-icon" data-target="icon" aria-label="Pick icon color">
                <div class="cp-swatch-fill" id="cp-fill-icon" style="background:#ffffff"></div>
              </button>
              <input class="cp-hex-input" id="cp-hex-icon" type="text" value="#ffffff" maxlength="7" spellcheck="false" autocomplete="off" />
            </div>
            <span class="cp-fa-only" id="cp-fa-only-note">Emoji use their own colors</span>
          </div>
          <div class="color-field">
            <label>Background</label>
            <div class="bgtype-row">
              <button type="button" class="choice-btn bgtype-btn active" data-bgtype="solid" aria-pressed="true">Solid</button>
              <button type="button" class="choice-btn bgtype-btn" data-bgtype="gradient" aria-pressed="false">Gradient</button>
            </div>
            <div class="cp-row" id="cp-row-bg">
              <button type="button" class="cp-swatch" id="cp-swatch-bg" data-target="bg" aria-label="Pick background color">
                <div class="cp-swatch-fill" id="cp-fill-bg" style="background:#ff4136"></div>
              </button>
              <input class="cp-hex-input" id="cp-hex-bg" type="text" value="#ff4136" maxlength="7" spellcheck="false" autocomplete="off" />
            </div>
            <div class="bg-gradient-panel" id="bg-gradient-panel">
              <div class="cp-row" id="cp-row-bg2">
                <button type="button" class="cp-swatch" id="cp-swatch-bg2" data-target="bg2" aria-label="Pick gradient end color">
                  <div class="cp-swatch-fill" id="cp-fill-bg2" style="background:#ffffff"></div>
                </button>
                <input class="cp-hex-input" id="cp-hex-bg2" type="text" value="#ffffff" maxlength="7" spellcheck="false" autocomplete="off" />
              </div>
              <div class="angle-row" role="group" aria-label="Gradient direction">
                <button type="button" class="angle-btn" data-angle="0" aria-pressed="false" title="Up (0°)">↑</button>
                <button type="button" class="angle-btn" data-angle="45" aria-pressed="false" title="Up-right (45°)">↗</button>
                <button type="button" class="angle-btn active" data-angle="90" aria-pressed="true" title="Right (90°)">→</button>
                <button type="button" class="angle-btn" data-angle="135" aria-pressed="false" title="Down-right (135°)">↘</button>
                <button type="button" class="angle-btn" data-angle="180" aria-pressed="false" title="Down (180°)">↓</button>
                <button type="button" class="angle-btn" data-angle="225" aria-pressed="false" title="Down-left (225°)">↙</button>
                <button type="button" class="angle-btn" data-angle="270" aria-pressed="false" title="Left (270°)">←</button>
                <button type="button" class="angle-btn" data-angle="315" aria-pressed="false" title="Up-left (315°)">↖</button>
              </div>
              <div class="field">
                <label for="bg-angle">Angle — <span id="angle-label">90°</span></label>
                <input type="range" id="bg-angle" min="0" max="360" step="1" value="90" />
                <div class="font-note">0° points up · 90° points right</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Shared picker popup -->
      <div class="cp-popup" id="cp-popup">
        <div class="cp-canvas-wrap" id="cp-canvas-wrap">
          <canvas class="cp-canvas" id="cp-canvas" width="200" height="148"></canvas>
          <div class="cp-cursor" id="cp-cursor"></div>
        </div>
        <div class="cp-hue-track">
          <input type="range" class="cp-hue" id="cp-hue" min="0" max="360" step="1" value="0" />
        </div>
        <div class="cp-bottom">
          <div class="cp-preview"><div class="cp-preview-fill" id="cp-preview-fill"></div></div>
          <input class="cp-hex-popup" id="cp-hex-popup" type="text" maxlength="7" spellcheck="false" autocomplete="off" />
        </div>
      </div>

      <!-- Shape + scale -->
      <div class="panel">
        <div class="panel-title">Background Shape</div>
        <div class="shape-row">
          <button type="button" class="shape-btn" data-shape="none" aria-pressed="false">
            <div class="shape-icon none"></div>
            None
          </button>
          <button type="button" class="shape-btn active" data-shape="circle" aria-pressed="true">
            <div class="shape-icon circle"></div>
            Circle
          </button>
          <button type="button" class="shape-btn" data-shape="rounded" aria-pressed="false">
            <div class="shape-icon rounded"></div>
            Rounded
          </button>
          <button type="button" class="shape-btn" data-shape="square" aria-pressed="false">
            <div class="shape-icon square"></div>
            Square
          </button>
        </div>
        <hr class="divider" />
        <div class="field">
          <label for="icon-scale">Icon Scale — <span id="size-label">70%</span></label>
          <input type="range" id="icon-scale" min="20" max="120" value="70" />
        </div>
        <div class="field">
          <label for="icon-offset">Icon Offset — <span id="offset-label">0%</span></label>
          <input type="range" id="icon-offset" min="-50" max="50" value="0" />
          <div class="font-note">− moves up · + moves down</div>
        </div>
      </div>

      <!-- Export -->
      <div class="panel">
        <div class="panel-title">Export</div>

        <label style="display:block;margin-bottom:0.45rem;">Resolution Presets</label>
        <div class="preset-grid">
          <button type="button" class="preset-btn" aria-pressed="false">16px</button>
          <button type="button" class="preset-btn" aria-pressed="false">32px</button>
          <button type="button" class="preset-btn" aria-pressed="false">64px</button>
          <button type="button" class="preset-btn active" aria-pressed="true">128px</button>
          <button type="button" class="preset-btn" aria-pressed="false">256px</button>
          <button type="button" class="preset-btn" aria-pressed="false">512px</button>
          <button type="button" class="preset-btn" aria-pressed="false">1024px</button>
          <button type="button" class="preset-btn" aria-pressed="false">2048px</button>
        </div>

        <label style="display:block;margin-bottom:0.45rem;" for="custom-w">Custom Size</label>
        <div class="custom-res">
          <input type="text" id="custom-w" value="128" style="text-align:center;" />
          <span>×</span>
          <input type="text" id="custom-h" value="128" style="text-align:center;" />
          <span>px</span>
        </div>

        <div class="export-row">
          <button type="button" class="btn export-btn" data-fmt="svg"><span class="btn-fmt">SVG</span> Export</button>
          <button type="button" class="btn export-btn" data-fmt="png"><span class="btn-fmt">PNG</span> Export</button>
        </div>
        <div class="status-msg error" id="export-error">Enter a valid icon, text, or emoji first.</div>

        <div class="android-divider"><hr /><span>Android</span><hr /></div>

        <label class="checkbox-row" id="material-row" for="material-toggle">
          <div class="custom-checkbox">
            <input type="checkbox" id="material-toggle" />
            <div class="checkbox-box"><Icon name="check" /></div>
          </div>
          <div class="checkbox-text">
            <span class="checkbox-label">Include Material You / Themed Icons</span>
            <span class="checkbox-sub" id="material-sub">Adds &lt;monochrome&gt; layer for Android 13+</span>
          </div>
        </label>
        <button type="button" class="android-btn" id="android-btn">
          <span style="font-size:1.05rem;display:inline-flex;"><Icon name="android" /></span>
          <span>
            <span class="android-label">Export Android Package</span>
            <span class="android-sub">· .zip</span>
          </span>
        </button>

        <div class="progress-wrap" id="progress-wrap">
          <div class="progress-bar-track"><div class="progress-bar-fill" id="progress-fill"></div></div>
          <div class="progress-label" id="progress-label">Preparing…</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Non-square background dialog (Android export / Material You gate) -->
  <div class="modal-overlay" id="shape-dialog">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="shape-dialog-title">
      <div class="modal-title" id="shape-dialog-title">Square background recommended</div>
      <p class="modal-text">Android applies its own mask (circle, squircle, …) to adaptive icons. A baked-in circle or rounded background will clash with it — switch to Square so the launcher can mask freely.</p>
      <div class="modal-actions">
        <button type="button" class="modal-btn primary" id="shape-dialog-primary">Switch to Square</button>
        <button type="button" class="modal-btn" id="shape-dialog-secondary">Keep Current Shape</button>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  import '../../scripts/tools/icon-maker';
</script>
