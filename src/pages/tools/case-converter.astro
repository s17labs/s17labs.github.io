---
import ToolLayout from '../../components/ToolLayout.astro';
import Icon from '../../components/Icon.astro';
import { FORMATS, DEFAULT_FORMAT_ID } from '../../scripts/tools/case-converter';

const title = 'Case Converter | s17 Labs Tools';
const description =
  'Convert strings between 15 programming and writing conventions — camelCase, snake_case, kebab-case, PascalCase, and more.';
const tagline = 'Convert text between 15 programming conventions and writing formats — instantly, in your browser.';
---

<ToolLayout title={title} description={description} heading="Case Converter" tagline={tagline}>
  <!-- Input -->
  <div class="panel">
    <h2 class="panel-title"><label for="input">Input</label></h2>
    <textarea id="input" placeholder="Type or paste text here…" spellcheck="false" autocomplete="off" aria-label="Text to convert"></textarea>
  </div>

  <!-- Format selector -->
  <div class="panel">
    <h2 class="panel-title">Format</h2>
    <div class="case-grid" id="case-grid">
      {
        FORMATS.map((fmt) => (
          <button
            type="button"
            class:list={['choice-btn', { active: fmt.id === DEFAULT_FORMAT_ID }]}
            data-id={fmt.id}
            aria-pressed={fmt.id === DEFAULT_FORMAT_ID}
          >
            <span>{fmt.label}</span>
            <span class="case-preview">{fmt.preview}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Output -->
  <div class="panel">
    <h2 class="panel-title"><label for="output">Output</label></h2>
    <div class="output-wrap">
      <textarea id="output" readonly spellcheck="false" aria-label="Converted text" aria-live="polite"></textarea>
      <button type="button" class="copy-btn" id="copy-btn" aria-label="Copy output to clipboard">
        <span class="copy-state copy-idle"><Icon name="copy" /> Copy</span>
        <span class="copy-state copy-done"><Icon name="check" /> Copied</span>
      </button>
    </div>
  </div>
</ToolLayout>

<script>
  import '../../scripts/tools/case-converter';
</script>

<style>
  /* Textarea */
  textarea {
    padding: 0.8rem;
  }

  textarea#output {
    resize: none;
    min-height: 90px;
    cursor: default;
  }

  /* Case format buttons */
  .case-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Format buttons: shared .choice-btn + column layout for label/preview */
  #case-grid .choice-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    text-align: left;
  }

  .case-preview {
    font-size: 0.65rem;
    color: var(--secondary-text);
    opacity: 0.6;
    font-family: 'Courier New', monospace;
  }

  #case-grid .choice-btn.active .case-preview {
    opacity: 0.8;
  }

  /* Output */
  .output-wrap {
    position: relative;
  }

  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--surface-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--secondary-text);
    padding: 0.45rem 0.8rem;
    font-size: 0.75rem;
    cursor: pointer;
    font-family: Verdana, sans-serif;
    transition: all var(--t);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .copy-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* Copy / Copied state swap */
  .copy-state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .copy-done {
    display: none;
  }

  .copy-btn.copied .copy-idle {
    display: none;
  }

  .copy-btn.copied .copy-done {
    display: inline-flex;
  }

  @media (max-width: 580px) {
    #case-grid .choice-btn {
      padding: 0.4rem 0.6rem;
      font-size: 0.75rem;
    }
  }
</style>
