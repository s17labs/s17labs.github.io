---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import BackLinkFit from '../components/BackLinkFit.astro';
import { SITE } from '../data/site';
import '../styles/tool.css';
import '../styles/design.css';

const title = 'Privacy | s17 Labs';
const description =
  'Privacy at s17 Labs — no accounts, no tracking, no analytics. Tools run entirely on your device.';
---

<BaseLayout title={title} description={description}>
  <div class="ds-page">
    <header class="ds-hero">
      <a href="/" class="back-link" aria-label="Back to Home">
        <Icon name="arrow-left" /><span class="back-label">Home</span>
      </a>
      <h1><span class="cube"></span> Privacy</h1>
    </header>
    <BackLinkFit />
    <p class="ds-lead">
      No accounts. No tracking. No analytics. This site is a static bundle of
      files — there is nothing here that can follow you.
    </p>

    <section class="ds-section">
      <p class="ds-kicker">Policy</p>
      <h2>Your data stays yours</h2>
      <p>
        Everything you type, paste, or drop into s17 Labs Tools is processed
        locally in your browser and never uploaded anywhere. Close the tab and
        it's gone — nothing is stored on a server because there is no server.
      </p>
    </section>

    <section class="ds-section">
      <p class="ds-kicker">Policy</p>
      <h2>Network requests</h2>
      <p>
        The pages themselves make zero requests of their own: no analytics
        beacons, no cookies, no fingerprinting. Two exceptions, both visible
        and in your control:
      </p>
      <table class="ds-table">
        <thead><tr><th>When</th><th>What leaves your device</th></tr></thead>
        <tbody>
          <tr>
            <td>Icon Maker emoji</td>
            <td>Fetching a Noto/Twemoji glyph requests that one SVG file from the jsDelivr CDN. Nothing else is sent.</td>
          </tr>
          <tr>
            <td>Hosting</td>
            <td>GitHub Pages serves these static files and, like any host, may keep routine anonymized server logs.</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="ds-section">
      <p class="ds-kicker">Policy</p>
      <h2>Questions</h2>
      <p>
        Something unclear? Reach out on
        <a href={SITE.orgUrl} target="_blank" rel="noopener noreferrer" style="text-decoration:underline;">GitHub</a>
        or <a href={SITE.socials.x.url} target="_blank" rel="noopener noreferrer" style="text-decoration:underline;">X</a>.
      </p>
      <p>
        Canonical text:
        <a href="https://github.com/s17labs/s17labs.github.io/blob/main/docs/PRIVACY.md" target="_blank" rel="noopener noreferrer" style="text-decoration:underline;">docs/PRIVACY.md</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/back-link';
</script>
