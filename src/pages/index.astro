---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <div class="shell">
    <div class="main">
      <div class="wrapper">
        <div id="home-view">
          <header class="header header-col">
            <h1><span class="cube"></span> {SITE.title}</h1>
            <p>{SITE.description}</p>
          </header>
          <div class="card">
            <p>At <b>s17 Labs</b>, we prioritize efficiency and performance in every line of code. Our projects focus on full-stack development, browser-level optimization, and creating superior ways to interact with digital content.</p>
            <div class="card-link">
              <a href={SITE.orgUrl} class="github-link" target="_blank" rel="noopener noreferrer">
                <Icon name="github" /> GitHub
              </a>
              <a href={SITE.toolsUrl} class="github-link">
                <Icon name="toolbox" /> s17 Labs Tools
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .header-col {
    flex-direction: column;
    gap: 0.5rem;
  }

  .header-col p {
    max-width: 34ch;
  }
</style>
