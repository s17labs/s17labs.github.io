---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/TopBar.astro';
import SearchDialog from '../components/SearchDialog.astro';
import SearchFab from '../components/SearchFab.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Page header for the top bar. Omit for a bare search FAB (home). */
  barTitle?: string;
  /** Back target. Omit on top-level pages — the bar then shows no back link. */
  backHref?: string;
  backLabel?: string;
  /** Content measure the bar tracks, in px. */
  barWidth?: number;
  /** Third-party origins to warm up (Icon Maker's emoji CDN only). */
  preconnect?: string[];
}

const { title, description, barTitle, backHref, backLabel, barWidth, preconnect } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {preconnect?.map((href) => <link rel="preconnect" href={href} crossorigin />)}
    {preconnect?.map((href) => <link rel="dns-prefetch" href={href} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {
      barTitle ? (
        <TopBar
          title={barTitle}
          backHref={backHref}
          backLabel={backLabel}
          width={barWidth}
        />
      ) : (
        <SearchFab />
      )
    }
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SearchDialog />
    <Footer />
    <div id="live-region" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/range-fill';
    </script>
    <script>
      import '../scripts/topbar';
    </script>
  </body>
</html>
