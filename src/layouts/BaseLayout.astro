---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/TopBar.astro';
import SearchDialog from '../components/SearchDialog.astro';
import SearchFab from '../components/SearchFab.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Page header for the top bar. Omit for a bare search FAB (home). */
  barTitle?: string;
  /** Back target. Omit on top-level pages — the bar then shows no back link. */
  backHref?: string;
  backLabel?: string;
  /** Content measure the bar tracks, in px. */
  barWidth?: number;
}

const { title, description, barTitle, backHref, backLabel, barWidth } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    {
      barTitle ? (
        <TopBar
          title={barTitle}
          backHref={backHref}
          backLabel={backLabel}
          width={barWidth}
        />
      ) : (
        <SearchFab />
      )
    }
    <slot />
    <SearchDialog />
    <Footer />
  </body>
</html>

<script>
  import '../scripts/topbar';
</script>
