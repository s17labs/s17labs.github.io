---
import Icon from './Icon.astro';
import type { IconName } from '../icons';
import { SITE } from '../data/site';

const year = new Date().getFullYear();

interface LinkItem {
  label: string;
  href: string;
  icon?: IconName;
  external?: boolean;
}

const sections: { title: string; items: LinkItem[] }[] = [
  {
    title: 'Pages',
    items: [
      { label: 'Tools', href: SITE.toolsUrl },
      { label: 'Design', href: SITE.designUrl },
      { label: 'Projects', href: SITE.projectsUrl },
      { label: 'Privacy', href: SITE.privacyUrl },
    ],
  },
  {
    // Single links that live nowhere else in the footer.
    title: 'Resources',
    items: [
      { label: 'View Source', href: 'https://github.com/s17labs/s17labs.github.io', external: true },
      { label: 'Brand Assets', href: 'https://github.com/s17labs/assets', external: true },
      { label: 'All Repositories', href: 'https://github.com/orgs/s17labs/repositories', external: true },
    ],
  },
  {
    title: 'Links',
    items: [
      { label: 'GitHub', href: SITE.orgUrl, icon: 'github', external: true },
      { label: SITE.socials.x.name, href: SITE.socials.x.url, icon: 'x', external: true },
      { label: SITE.socials.discord.name, href: SITE.socials.discord.url, icon: 'discord', external: true },
      { label: SITE.parent.name, href: SITE.parent.url, icon: 'globe', external: true },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-cols">
      <div class="footer-col">
        <a href="/" class="footer-logo">
          <span class="cube"></span>
          {SITE.title}
        </a>
        <p class="footer-tagline">{SITE.description}</p>
      </div>

      {
        sections.map((section) => (
          <div class="footer-col">
            <span class="footer-col-title">{section.title}</span>
            <ul class="footer-links">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.icon && <Icon name={item.icon} />}
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <hr class="footer-divider" />

    <p class="footer-byline">
      {SITE.byline.prefix}
      <a href={SITE.byline.url} target="_blank" rel="noopener noreferrer">{SITE.byline.name}</a>
    </p>
    <p class="footer-copy">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>
