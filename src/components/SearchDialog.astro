---
import Icon from './Icon.astro';
---

{/* Search dialog + the markup both the top bar and the home FAB drive.
    Rendered once per page by BaseLayout. */}
<div
  class="topbar-search"
  data-search
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Search s17 Labs"
>
  <div class="topbar-search-card">
    <div class="topbar-search-field">
      <Icon name="search" class="topbar-search-icon" />
      <input
        type="text"
        class="topbar-search-input"
        data-search-input
        role="combobox"
        aria-label="Search tools, pages, and design sections"
        aria-expanded="true"
        aria-controls="topbar-results"
        aria-autocomplete="list"
        placeholder="Search tools, pages, design sections…"
        autocomplete="off"
        spellcheck="false"
      />
      {/* Clear only — hidden while the field is empty (scripts/topbar.ts
          toggles .is-visible), so it never doubles as a close button.
          Escape and the backdrop click are the ways out. */}
      <button type="button" class="topbar-search-clear" data-search-clear aria-label="Clear search" hidden>
        <Icon name="xmark" />
      </button>
    </div>
    <div
      class="topbar-results"
      id="topbar-results"
      data-search-results
      role="listbox"
      aria-label="Results"
    >
    </div>
    <div class="topbar-search-foot">
      <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
      <span><kbd>&crarr;</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <span class="topbar-search-shortcut"><kbd>/</kbd> or <kbd>&#8984; K</kbd></span>
    </div>
  </div>
</div>
