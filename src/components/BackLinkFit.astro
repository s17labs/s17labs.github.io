---
// Synchronous first-paint fit for the header back-link.
//
// Runs inline during parsing (before first paint), so the label verdict
// (show/collapse) is already correct in the first frame. The deferred
// src/scripts/back-link.ts module re-checks on resize/fonts/load.
// Plain JS, no imports — must stay parser-blocking.
---

<script is:inline>
  (function () {
    var link = document.querySelector('.back-link');
    var header = link && link.closest('.tool-header, .ds-hero');
    var title = header && header.querySelector('h1');
    if (!link || !title) return;
    var linkBox = link.getBoundingClientRect();
    var titleBox = title.getBoundingClientRect();
    link.classList.add(linkBox.right + 8 > titleBox.left ? 'compact' : 'fitted');
  })();
</script>
