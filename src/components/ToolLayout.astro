---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import '../styles/tool.css';

interface Props {
  title: string;
  description?: string;
  heading: string;
  tagline?: string;
  maxWidth?: number;
}

const {
  title,
  description = SITE.description,
  heading,
  tagline,
  maxWidth = 680,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="tool-top">
    <slot name="pre" />
    <div class="tool-header">
      <a href={SITE.toolsUrl} class="back-link" aria-label="Back to Tools">
        <Icon name="arrow-left" /><span class="back-label">Tools</span>
      </a>
      <h1>
        <span class="cube"></span>
        {heading}
      </h1>
    </div>
    {tagline && <p class="tool-desc">{tagline}</p>}
  </div>

  <div class="page" style={`max-width:${maxWidth}px`}>
    <slot />
  </div>

  <div class="tool-bottom">
    <div class="more-tools">
      <h3>More s17 Labs Tools</h3>
      <p>Discover more free, browser-based utilities designed for creators and developers.</p>
      <a href={SITE.toolsUrl} class="more-tools-btn">
        <Icon name="arrow-left" /> View More Tools
      </a>
    </div>
  </div>
</BaseLayout>
