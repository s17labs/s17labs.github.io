---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import '../styles/tool.css';

interface Props {
  title: string;
  description?: string;
  heading: string;
  tagline?: string;
  maxWidth?: number;
  preconnect?: string[];
}

const {
  title,
  description = SITE.description,
  heading,
  tagline,
  maxWidth = 680,
  preconnect,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  barTitle={heading}
  backHref={SITE.toolsUrl}
  backLabel="Tools"
  barWidth={900}
  preconnect={preconnect}
>
  <div class="tool-top">
    <slot name="pre" />
    {tagline && <p class="tool-desc">{tagline}</p>}
  </div>

  <div class="page" style={`max-width:${maxWidth}px`}>
    <slot />
  </div>

  <div class="tool-bottom">
    <div class="more-tools">
      <h3>More s17 Labs Tools</h3>
      <p>Discover more free, browser-based utilities designed for creators and developers.</p>
      <a href={SITE.toolsUrl} class="more-tools-btn">
        <Icon name="arrow-left" />View More Tools
      </a>
    </div>
  </div>
</BaseLayout>
